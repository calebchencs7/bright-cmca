\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Qualitative building damage assessment results on BRIGHT. From top to bottom, the rows show explosion, volcanic eruption, wildfire, flood, hurricane, earthquake, and conflict examples. From left to right, the columns show pre-event optical imagery, post-event SAR imagery, ground truth, and predictions from UNet, DeepLabV3+, SiamCRNN, SiamAttnUNet, DamageFormer, and ChangeMamba. All predictions use the CMCA+DA-CutMix\ configuration. White, green, beige, and red denote background, intact, damaged, and destroyed buildings, respectively.}}{10}{figure.5}\protected@file@percent }
\newlabel{fig:qualitative_results}{{5}{10}{Qualitative building damage assessment results on BRIGHT. From top to bottom, the rows show explosion, volcanic eruption, wildfire, flood, hurricane, earthquake, and conflict examples. From left to right, the columns show pre-event optical imagery, post-event SAR imagery, ground truth, and predictions from UNet, DeepLabV3+, SiamCRNN, SiamAttnUNet, DamageFormer, and ChangeMamba. All predictions use the \cmca +\dacutmix \ configuration. White, green, beige, and red denote background, intact, damaged, and destroyed buildings, respectively}{figure.5}{}}
